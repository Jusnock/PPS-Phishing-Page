# ==========================================
# CONFIGURACIÓN DEL SISTEMA (PHISHING QUIZ)
# ==========================================

# Puertos expuestos en el Host
FRONTEND_PORT=80
BACKEND_PORT=8000
DB_PORT=5432

# URLs públicas (con el dominio o IP del servidor)
# FRONTEND_URL es la URL a la que se accede al frontend desde el navegador
FRONTEND_URL=http://localhost
# BACKEND_URL es la URL del backend/API
BACKEND_URL=http://localhost:8000
# VITE_API_URL debe coincidir con la URL pública del backend para el navegador del cliente
VITE_API_URL=http://localhost:8000

# Base de datos PostgreSQL
DB_USER=admin
DB_PASSWORD=Sistemas1.
DB_NAME=phishing_quiz
DB_HOST=db

# Seguridad
# Clave secreta para firmar tokens JWT (se autogenera automáticamente si se usa install.sh)
SECRET_KEY=

# Administradores del sistema creados al inicio (separados por coma)
SUPERADMIN_EMAILS=vazquezjuanfrancisco49@gmail.com

# Autenticación con Google (Opcional - dejar vacío si no se usa)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Servidor de Correo SMTP (Para envío de campañas de phishing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
